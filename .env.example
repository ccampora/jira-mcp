# Jira Data Center connection settings
JIRA_BASE_URL=https://jira.company.com

# --- Authentication: choose ONE method ---

# Option 1 (preferred): rotating Personal Access Tokens as a JSON array
JIRA_PATS=["PAT_ACCOUNT_1","PAT_ACCOUNT_2","PAT_ACCOUNT_3"]

# Option 2: single Personal Access Token (backward-compatible fallback)
JIRA_PAT=your-personal-access-token

# Option 3: Basic authentication (username + password)
JIRA_USERNAME=myuser
JIRA_PASSWORD=mypassword

# --- Confluence Data Center / Server (optional) ---
# Confluence tools are only enabled when CONFLUENCE_BASE_URL is set.
# CONFLUENCE_BASE_URL=https://confluence.company.com

# Confluence credentials are optional. If omitted, the legacy single JIRA_PAT
# or Jira Basic credentials are reused. JIRA_PATS rotation is Jira-only.
# CONFLUENCE_PAT=your-confluence-personal-access-token
# CONFLUENCE_USERNAME=myuser
# CONFLUENCE_PASSWORD=mypassword

# Optional settings
# Request timeout in milliseconds (default: 15000)
JIRA_TIMEOUT_MS=15000

# Reject unauthorized TLS certificates (set to "false" only for trusted internal CAs without a valid chain)
JIRA_TLS_REJECT_UNAUTHORIZED=true

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# MCP transport: stdio (default) or http
# MCP_TRANSPORT=http

# HTTP listen port when MCP_TRANSPORT=http (default: 8787)
# PORT=8787
