# Jira Cloud connection (URL required; credentials may instead come from HTTP headers)
# Unscoped API token:
JIRA_BASE_URL=https://example.atlassian.net
# Scoped API token (use the site's cloudId):
# JIRA_BASE_URL=https://api.atlassian.com/ex/jira/<cloudId>
JIRA_CLOUD_EMAIL=jira-mcp@example.com
JIRA_CLOUD_API_TOKEN=your-cloud-api-token

# Copilot Studio API-key alternative (HTTP only):
# Set the API-key header name to X-Atlassian-Credentials and enter email,api-token.
# Keep JIRA_BASE_URL server-side; the two credential variables above may be omitted.
# Confluence uses its own explicit X-Confluence-Credentials header or env credentials.
# Combined credentials reject caller-supplied base URL overrides.

# Cloud is the only supported deployment. These selectors may be omitted.
# JIRA_DEPLOYMENT=cloud
# CONFLUENCE_DEPLOYMENT=cloud
# Remove legacy PAT, username, and password variables; they are rejected.

# Optional Confluence Cloud connection; all three values are required together.
# Confluence credentials are never inherited from Jira.
# CONFLUENCE_BASE_URL=https://example.atlassian.net/wiki
# For scoped tokens (requires Confluence scopes):
# CONFLUENCE_BASE_URL=https://api.atlassian.com/ex/confluence/<cloudId>/wiki
# CONFLUENCE_CLOUD_EMAIL=wiki-mcp@example.com
# CONFLUENCE_CLOUD_API_TOKEN=your-confluence-cloud-api-token

# Request timeout in milliseconds (default: 15000)
JIRA_TIMEOUT_MS=15000

# HTTPS and certificate verification are required for both products.
JIRA_TLS_REJECT_UNAUTHORIZED=true

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# MCP transport: stdio (default) or http
# MCP_TRANSPORT=http

# HTTP listen port when MCP_TRANSPORT=http (default: 8787)
# PORT=8787
